FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /node ./cmd/node

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /node /node
# Config is provided per-container via environment or volume mount
ENTRYPOINT ["/node"]
CMD ["-config", "/config/node.yaml"]
